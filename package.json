{
	"name": "glicko-irt-quiz-site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "bun --bun vite dev",
		"build": "bun --bun vite build",
		"preview": "bun --bun vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && biome check ./src",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch && biome check ./src --watch",
		"format": "biome check ./src --write",
		"format:watch": "biome check ./src --write --watch",
		"db:push": "bun --bun drizzle-kit push"
	},
	"dependencies": {
		"better-auth": "^1.7.5",
		"drizzle-orm": "^1.0.0-rc.4"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/bun": "^1.4.2",
		"auth": "^1.7.5",
		"drizzle-kit": "^1.0.0-rc.4",
		"postcss": "^8.5.28",
		"postcss-preset-env": "^11.5.3",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"temporal-polyfill": "latest",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	}
}
